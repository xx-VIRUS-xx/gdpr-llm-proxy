# Copy to .env and adjust. All settings are also overridable as real
# environment variables with the GLP_ prefix (see app/config.py).

# --- Token mapping store ---
GLP_STORE_BACKEND=memory          # "memory" (local dev) or "redis" (any shared/deployed env)
GLP_REDIS_URL=redis://localhost:6379/0

# Fernet key encrypting token->PII mappings at rest. MUST be changed for any
# non-local environment. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GLP_MAPPING_ENCRYPTION_KEY=wJ0k8p8b9m3z1f4qz3f0m7f5m1c3v9m2x8b7v6n5m4k=

# How long a token->PII mapping lives before it is permanently unrecoverable.
GLP_MAPPING_TTL_SECONDS=600

# --- PII detection ---
GLP_SPACY_MODEL=en_core_web_lg
GLP_DETECTION_SCORE_THRESHOLD=0.4

# --- Outbound LLM forwarding ---
GLP_OUTBOUND_MODE=mock            # "mock" | "openai" | "anthropic"
GLP_OPENAI_API_KEY=
GLP_OPENAI_BASE_URL=https://api.openai.com/v1
GLP_ANTHROPIC_API_KEY=
GLP_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GLP_OUTBOUND_TIMEOUT_SECONDS=30

# --- Usage tracking ---
GLP_USAGE_BACKEND=memory          # "memory" or "redis"
